{
  "_comment": "Wan22 Loop API template — generation only (no Interpolation / Upscale / Mini Meme). Built/patched by comfyWan22Loop.ts using stable node ids.",
  "_sourceUiWorkflow": "wan22-loop-ui.json",
  "_modes": {
    "i2v": "WanImageToVideo (node 9)",
    "flf2v": "WanFirstLastFrameToVideo (node 9) + end image (node 8)",
    "wanfun_inpaint": "WanFunInpaintToVideo (node 9) + end image (node 8)"
  },
  "_nodeIds": {
    "1": "UNETLoader high",
    "2": "UNETLoader low",
    "3": "CLIPLoader",
    "4": "VAELoader",
    "5": "CLIPTextEncode positive",
    "6": "CLIPTextEncode negative",
    "7": "LoadImage start",
    "8": "LoadImage end (FLF / WanFunInpaint)",
    "9": "Wan conditioning",
    "10": "ModelSamplingSD3 high",
    "11": "ModelSamplingSD3 low",
    "12": "LoraLoaderModelOnly high (optional)",
    "13": "LoraLoaderModelOnly low (optional)",
    "14": "KSamplerAdvanced high (cfgHigh, 0..refinerStep)",
    "15": "KSamplerAdvanced low (cfg, refinerStep..steps)",
    "16": "VAEDecode",
    "17": "CreateVideo",
    "18": "SaveVideo"
  },
  "_excludedPostprocess": [
    "Interpolation",
    "Frame Interpolation Model",
    "Upscale 2x simple",
    "Upscale 2x with model",
    "upscale model",
    "upscale 2x with RTX Upscaler & Refiner",
    "Mini Meme",
    "Perfect loop",
    "Watermark",
    "Extract Last Frame"
  ],
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "PLACEHOLDER_HIGH.safetensors", "weight_dtype": "default" }
    },
    "2": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "PLACEHOLDER_LOW.safetensors", "weight_dtype": "default" }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "wan_2.1_vae.safetensors" }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["3", 0] }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["3", 0] }
    },
    "7": {
      "class_type": "LoadImage",
      "inputs": { "image": "PLACEHOLDER_START.png" }
    },
    "9": {
      "class_type": "WanImageToVideo",
      "inputs": {
        "positive": ["5", 0],
        "negative": ["6", 0],
        "vae": ["4", 0],
        "start_image": ["7", 0],
        "width": 544,
        "height": 960,
        "length": 81,
        "batch_size": 1
      }
    },
    "10": {
      "class_type": "ModelSamplingSD3",
      "inputs": { "model": ["1", 0], "shift": 8 }
    },
    "11": {
      "class_type": "ModelSamplingSD3",
      "inputs": { "model": ["2", 0], "shift": 8 }
    },
    "14": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "model": ["10", 0],
        "add_noise": "enable",
        "noise_seed": 0,
        "steps": 8,
        "cfg": 5,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": ["9", 0],
        "negative": ["9", 1],
        "latent_image": ["9", 2],
        "start_at_step": 0,
        "end_at_step": 3,
        "return_with_leftover_noise": "enable"
      }
    },
    "15": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "model": ["11", 0],
        "add_noise": "disable",
        "noise_seed": 0,
        "steps": 8,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": ["9", 0],
        "negative": ["9", 1],
        "latent_image": ["14", 0],
        "start_at_step": 3,
        "end_at_step": 8,
        "return_with_leftover_noise": "disable"
      }
    },
    "16": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["15", 0], "vae": ["4", 0] }
    },
    "17": {
      "class_type": "CreateVideo",
      "inputs": { "images": ["16", 0], "fps": 16 }
    },
    "18": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["17", 0],
        "filename_prefix": "i2v/Wan2.2_i2v",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
